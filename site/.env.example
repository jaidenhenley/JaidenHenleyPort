# Firebase Analytics. Astro inlines PUBLIC_ vars at build time, so these are
# visible in the shipped bundle, which is expected for a Firebase web config.
# Leave them unset locally: analytics is omitted entirely when they are absent.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
