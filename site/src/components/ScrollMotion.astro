---
/**
 * Portfolio-wide scroll choreography.
 *
 * Targets are matched by selector rather than hand-tagged, so every page picks
 * up the same rhythm. Each group declares an intent (see motion.css) that sets
 * the kind of reveal it gets: headlines pull into focus, media opens or rises,
 * rules wipe, chips settle, body copy barely moves.
 *
 * Groups are matched in order and an element belongs to the first group that
 * claims it, so the specific selectors sit above the broad ones.
 *
 * Stagger is decided when a batch actually reveals, not by DOM order at load,
 * so a grid whose second row sits a full viewport lower does not inherit a
 * delay meant to cascade off the first row.
 *
 * Only the first page of a visit gets the overture and the first-screen
 * reveals. After a client-side navigation, whatever is already on screen is
 * settled at once with no transition, so moving between pages never blanks
 * the screen or replays an opening; only content below the fold reveals.
 */
---

<script>
	type Intent =
		| 'text'
		| 'headline'
		| 'words'
		| 'surface'
		| 'aside'
		| 'media'
		| 'frame'
		| 'rule'
		| 'pop'
		| 'stat';

	const GROUPS: { selector: string; intent: Intent }[] = [
		// Page titles, one word at a time.
		{ selector: '.hero-copy h1', intent: 'words' },
		{ selector: '.hero .col-type h1', intent: 'words' },
		{ selector: '.page-header h1', intent: 'words' },

		// Section titles pull into focus.
		{ selector: '.section-head h2', intent: 'headline' },
		{ selector: '.about-copy h2', intent: 'headline' },
		{ selector: '.section.testimonials h2', intent: 'headline' },
		{ selector: '.main .block h2', intent: 'headline' },
		{ selector: '.demo .copy h2', intent: 'headline' },

		// Accent rules wipe in beneath their titles.
		{ selector: '.main .block .rule', intent: 'rule' },
		{ selector: '.demo .copy .rule', intent: 'rule' },

		// Big numbers count up out of a clip; their labels follow quietly.
		{ selector: '.stats .stat .value', intent: 'stat' },
		{ selector: '.stats .stat .label', intent: 'text' },

		// Tags pop, but only where they are the content rather than a detail
		// inside something that is already animating.
		{ selector: '.about-skills .chip', intent: 'pop' },
		{ selector: '.facts .chip', intent: 'pop' },

		// Sidebars drift in from the edge they live on.
		{ selector: '.about-skills', intent: 'aside' },
		{ selector: '.facts', intent: 'aside' },

		// Rectangular pictures open from a mask; devices rise into place.
		{ selector: '.portrait img', intent: 'frame' },
		{ selector: '.portrait figcaption', intent: 'text' },
		{ selector: '.demo.is-wide .media', intent: 'frame' },
		{ selector: '.demo.is-phone .media', intent: 'media' },

		// Home
		{ selector: '.hero-copy > *', intent: 'text' },
		{ selector: '.section.work > .container > *', intent: 'text' },
		{ selector: '.project-grid > *', intent: 'media' },
		{ selector: '.about-copy > *', intent: 'text' },
		{ selector: '.section.testimonials > .container > *', intent: 'text' },
		{ selector: '.quote-grid > *', intent: 'surface' },

		// Case study index
		{ selector: '.featured-section .card', intent: 'media' },
		{ selector: '.rest-section .grid > *', intent: 'media' },

		// Case study
		{ selector: '.cs > .crumb', intent: 'text' },
		{ selector: '.hero .col-type > *', intent: 'text' },
		{ selector: '.hero .col-media', intent: 'media' },
		{ selector: '.demo .copy > *', intent: 'text' },
		{ selector: '.main > .block > *', intent: 'text' },
		{ selector: '.approach li', intent: 'surface' },
		{ selector: '.screens figure', intent: 'media' },
		{ selector: '.outcome > :not(.stats)', intent: 'text' },
		{ selector: '.next', intent: 'surface' },

		// Resume, contact, footers
		{ selector: '.resume .block', intent: 'surface' },
		{ selector: '.contact-section .grid > *', intent: 'surface' },
		{ selector: '.cta-footer .inner > *', intent: 'text' },
		{ selector: '.site-footer .inner > *', intent: 'text' },
		{ selector: '.page-header .inner > *', intent: 'text' },
	];

	/**
	 * The first screen gets its own opening rather than the same cascade as the
	 * rest of the page: a hand-timed ladder, so the portrait arrives, then the
	 * name, then the line about the work. Delays here are absolute and are used
	 * in place of the stagger, which is why they ignore MAX_DELAY_MS. The ladder
	 * is kept tight (last step at 600ms, everything settled by about 1.5s) so
	 * the order reads without the reader waiting on it, and it only ever plays
	 * on the first page load of a visit.
	 */
	const OVERTURE: { selector: string; delay: number }[] = [
		{ selector: '.hero .portrait img', delay: 0 },
		{ selector: '.hero-copy .eyebrow', delay: 120 },
		{ selector: '.hero-copy h1', delay: 200 },
		{ selector: '.hero-copy .hero-lede', delay: 380 },
		{ selector: '.hero .portrait figcaption', delay: 460 },
		{ selector: '.hero-copy .cta-row', delay: 520 },
		{ selector: '.hero-copy .socials', delay: 600 },
	];

	/**
	 * Cascade step per intent. Small things cascade tightly so a row of chips
	 * ripples; big things cascade slowly so each one gets its own moment.
	 */
	const STAGGER_MS: Record<Intent, number> = {
		text: 60,
		headline: 70,
		words: 0,
		surface: 70,
		aside: 0,
		media: 90,
		frame: 0,
		rule: 0,
		pop: 36,
		stat: 100,
	};
	const MAX_DELAY_MS = 320;

	/** Disposes the previous page's observer and listeners across navigation. */
	let teardown: (() => void) | null = null;
	/**
	 * True until the first page has been set up. The module is evaluated once
	 * and survives ClientRouter navigations, so this marks the difference
	 * between arriving at the site and moving around within it.
	 */
	let firstLoad = true;
	// Trigger just below the fold so motion reads as the page settling ahead of
	// the reader rather than reacting after they have already arrived.
	const LEAD_RATIO = 0.1;

	/**
	 * Wraps each word of a plain text heading so it can reveal on its own.
	 * Headings with markup inside are left whole and fall back to a headline
	 * reveal, so nothing is ever restructured that was not just text.
	 */
	function splitWords(el: HTMLElement): boolean {
		if (el.children.length || el.dataset.split === 'true') return el.dataset.split === 'true';
		const text = el.textContent ?? '';
		if (!text.trim()) return false;

		el.textContent = '';
		let index = 0;
		text.split(/(\s+)/).forEach((part) => {
			if (!part) return;
			if (/^\s+$/.test(part)) {
				el.append(part);
				return;
			}
			const span = document.createElement('span');
			span.className = 'w';
			span.style.setProperty('--w', String(index++));
			span.textContent = part;
			el.append(span);
		});
		el.dataset.split = 'true';
		return true;
	}

	function init() {
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const arriving = firstLoad;
		firstLoad = false;
		const claimed = new Set<Element>();
		const targets: HTMLElement[] = [];

		for (const { selector, intent } of GROUPS) {
			for (const el of document.querySelectorAll<HTMLElement>(selector)) {
				if (claimed.has(el)) continue;
				claimed.add(el);
				el.dataset.reveal = intent === 'words' && !reduced && !splitWords(el) ? 'headline' : intent;
				targets.push(el);
			}
		}

		// Hero elements keep their intent but trade the batch stagger for the
		// overture's own timing, and take the heavier treatment in motion.css.
		// Only on arrival: coming back to the home page does not replay it.
		const overture = new Map<Element, number>();
		if (arriving && !reduced) {
			for (const { selector, delay } of OVERTURE) {
				for (const el of document.querySelectorAll<HTMLElement>(selector)) {
					if (!el.dataset.reveal || overture.has(el)) continue;
					overture.set(el, delay);
					el.dataset.overture = '';
				}
			}
		}

		if (!('IntersectionObserver' in window)) {
			targets.forEach((el) => el.classList.add('is-revealed'));
			teardown = null;
			return;
		}

		const pending = new Set(targets);

		// After a client-side navigation, settle everything already on screen
		// at once. .is-instant switches transitions off (see motion.css) for the
		// frame the settled state is committed in, and is dropped two frames
		// later so hover and press transitions work as normal afterwards. All
		// positions are read before any class is written, to avoid a layout per
		// element.
		if (!arriving) {
			const onScreen = targets.filter((el) => el.getBoundingClientRect().top < innerHeight);
			onScreen.forEach((el) => {
				el.classList.add('is-instant', 'is-revealed');
				pending.delete(el);
			});
			if (onScreen.length) {
				requestAnimationFrame(() =>
					requestAnimationFrame(() => onScreen.forEach((el) => el.classList.remove('is-instant')))
				);
			}
		}

		/**
		 * Reveals a set together, cascading in visual reading order. Delay is
		 * assigned here rather than at load, so it always reflects what is
		 * genuinely entering at the same moment. Each intent counts its own
		 * cascade so a rule or a headline never inherits a chip's position.
		 */
		const revealBatch = (batch: HTMLElement[]) => {
			if (!batch.length) return;

			batch.sort((a, b) => {
				const ra = a.getBoundingClientRect();
				const rb = b.getBoundingClientRect();
				// Treat near-equal tops as one row so a grid cascades left to right.
				return Math.abs(ra.top - rb.top) > 4 ? ra.top - rb.top : ra.left - rb.left;
			});

			const seen: Partial<Record<Intent, number>> = {};

			batch.forEach((el) => {
				const intent = (el.dataset.reveal ?? 'text') as Intent;
				const fixed = overture.get(el);
				let delay = fixed ?? 0;

				// Reduced motion is a plain cross-fade, so there is no cascade.
				if (fixed === undefined && !reduced) {
					const index = seen[intent] ?? 0;
					seen[intent] = index + 1;
					delay = Math.min(index * STAGGER_MS[intent], MAX_DELAY_MS);
				}

				el.style.setProperty('--reveal-delay', `${delay}ms`);
				el.classList.add('is-animating', 'is-revealed');
				pending.delete(el);
				observer.unobserve(el);

				// Release the compositor layer once the motion is done. Word
				// reveals end on their children, so the timer is what closes them.
				let finished = false;
				const done = () => {
					if (finished) return;
					finished = true;
					el.classList.remove('is-animating');
					el.style.removeProperty('--reveal-delay');
				};
				el.addEventListener('transitionend', (event) => {
					if (event.target === el) done();
				});
				setTimeout(done, delay + (fixed === undefined ? 1200 : 1600));
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				revealBatch(
					entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement)
				);
			},
			{ rootMargin: `0px 0px ${LEAD_RATIO * 100}% 0px`, threshold: 0.01 }
		);

		pending.forEach((el) => observer.observe(el));

		// The observer can miss elements that are jumped past rather than scrolled
		// through: an anchor link, a restored scroll position, or a flung scroll
		// that never renders an intermediate frame. Sweep whatever is left behind.
		let sweeping = false;
		const sweep = () => {
			sweeping = false;
			if (!pending.size) {
				removeEventListener('scroll', onScroll);
				removeEventListener('resize', onScroll);
				return;
			}
			const limit = innerHeight * (1 + LEAD_RATIO);
			revealBatch([...pending].filter((el) => el.getBoundingClientRect().top < limit));
		};
		const onScroll = () => {
			if (sweeping) return;
			sweeping = true;
			requestAnimationFrame(sweep);
		};

		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll, { passive: true });
		requestAnimationFrame(sweep);

		teardown = () => {
			observer.disconnect();
			removeEventListener('scroll', onScroll);
			removeEventListener('resize', onScroll);
			teardown = null;
		};
	}

	/**
	 * The header carries transition:persist, so it survives navigation and must
	 * only ever be bound once. The flag lives on the element itself.
	 */
	function header() {
		const el = document.querySelector<HTMLElement>('.site-header');
		if (!el) return;

		const update = () => el.classList.toggle('is-scrolled', window.scrollY > 8);
		update();

		if (el.dataset.scrollBound === 'true') return;
		el.dataset.scrollBound = 'true';

		let ticking = false;
		addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
			},
			{ passive: true }
		);
	}

	function start() {
		teardown?.();
		init();
		header();
	}

	// astro:page-load fires on first paint and again after every client-side
	// navigation, which DOMContentLoaded does not once the router is in play.
	document.addEventListener('astro:page-load', start);

	// iOS Safari only applies :active on touch when a touchstart listener exists
	// somewhere above the element. An empty passive one on the document is
	// enough for the card and button press states in motion.css, and since the
	// module runs once it is bound once, surviving navigation with the document.
	document.addEventListener('touchstart', () => {}, { passive: true });
</script>
