---
import { Image } from 'astro:assets';
import frame from '../assets/frames/iphone-16-pro-black-titanium.png';

/**
 * Real iPhone 16 Pro (Black Titanium) device frame with the screenshot
 * composited into its transparent screen cutout.
 *
 * Frame art from github.com/weirdapps/mockups, MIT licensed,
 * Copyright (c) 2026 Dimitrios Plessas. See ../assets/frames/LICENSE.txt.
 *
 * Measured cutout: 1206x2622 at (102, 100) in the 1406x2822 frame. That is the
 * device's native resolution, so screenshots captured on an iPhone land 1:1.
 * The frame also draws the Dynamic Island, so captures that lack one get it here.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['phone', className]}>
	<div class="screen">
		<slot />
	</div>
	<Image class="bezel" src={frame} alt="" widths={[420, 840]} sizes="400px" aria-hidden="true" />
</div>

<style>
	.phone {
		position: relative;
		width: 100%;
		aspect-ratio: 1406 / 2822;
		container-type: inline-size;
		filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.28));
	}

	/* Exact cutout, as a share of the frame art. The bezel is too thin to hide a
	   square corner, so the content carries the screen's own 55pt corner radius. */
	.screen {
		position: absolute;
		left: 7.25462%;
		top: 3.54359%;
		width: 85.77525%;
		height: 92.91283%;
		overflow: hidden;
		border-radius: 11.7cqw;
		background: #000;
	}

	.screen :global(img),
	.screen :global(video) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Drawn over the content so the bezel masks the screen corners. */
	.bezel {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>
