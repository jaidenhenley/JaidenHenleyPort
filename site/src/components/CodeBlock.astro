---
interface Props {
	title: string;
	language: string;
	description: string;
	code: string;
}

const { title, language, description, code } = Astro.props;
---

<article class="snippet card">
	<header>
		<h3>{title}</h3>
		<div class="meta">
			<span class="chip">{language}</span>
			<button class="copy" type="button" data-copy aria-label={`Copy the ${title} code`}>
				Copy
			</button>
			<span class="visually-hidden" role="status" data-copy-status></span>
		</div>
	</header>
	<p>{description}</p>
	<pre><code>{code}</code></pre>
</article>

<style>
	.snippet {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 22px 24px 24px;
	}

	header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	h3 {
		font-size: var(--step-1);
		font-weight: 600;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.copy {
		min-height: 30px;
		padding: 0 12px;
		font-family: inherit;
		font-size: 12.5px;
		font-weight: 550;
		color: var(--fg-2);
		background: var(--surface-2);
		border: 1px solid var(--hairline-2);
		border-radius: var(--radius-sm);
		cursor: pointer;
	}

	.copy:hover {
		color: var(--fg);
	}

	p {
		font-size: var(--step-0);
		line-height: 1.55;
		color: var(--fg-2);
	}

	pre {
		margin: 0;
		overflow-x: auto;
		padding: 18px 20px;
		background: var(--surface-2);
		border: 1px solid var(--hairline-2);
		border-radius: var(--radius-md);
	}

	code {
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.6;
		color: var(--fg);
		white-space: pre;
		tab-size: 4;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
			if (btn.dataset.bound === 'true') continue;
			btn.dataset.bound = 'true';
			btn.addEventListener('click', async () => {
				const codeEl = btn.closest('.snippet')?.querySelector('code');
				const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
				const code = codeEl?.textContent ?? '';
				try {
					await navigator.clipboard.writeText(code);
					btn.textContent = 'Copied';
					if (status) status.textContent = 'Code copied';
				} catch {
					// Select the code so user can press Cmd/Ctrl+C
					if (codeEl) {
						const range = document.createRange();
						range.selectNodeContents(codeEl);
						const selection = window.getSelection();
						if (selection) {
							selection.removeAllRanges();
							selection.addRange(range);
						}
					}
					const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
					btn.textContent = isMac ? 'Press ⌘C' : 'Press Ctrl+C';
					if (status) status.textContent = `Code selected, ${btn.textContent} to copy`;
				}
				setTimeout(() => {
					btn.textContent = 'Copy';
					if (status) status.textContent = '';
				}, 2000);
			});
		}
	});
</script>
