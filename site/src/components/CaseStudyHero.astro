---
import { Image } from 'astro:assets';
import type { CaseStudy } from '../data/case-studies';

interface Props {
	title: string;
	study: CaseStudy;
}

const { title, study } = Astro.props;
const kicker = `${study.number} - ${study.category}`;
const isAppStore = study.primaryCta.href.includes('apps.apple.com');

// Shared-element name for the app icon, so the card that was clicked morphs
// into this frame. ProjectCard (and the featured card in case-studies.astro)
// derive the same string from the same title, and the browser only pairs two
// elements whose view-transition-name matches exactly, so keep this in step
// with those copies. The frame carries the name rather than the image inside
// it because it is what holds the 22.5% radius, border, and clip here.
const iconName = `icon-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<header class="hero">
	<div class="col-type">
		<div class="meta">
			<span class="eyebrow">{kicker} &middot; {study.tech}</span>
			<span class="status">{study.status}</span>
		</div>
		<h1>{title}</h1>
		<p class="lead">{study.lead}</p>
		<div class="cta-row">
			{
				isAppStore ? (
					<a class="badge-link" href={study.primaryCta.href} target="_blank" rel="noopener noreferrer">
						<img
							src="/images/AppStoreBadge.svg"
							alt={`Download ${title} on the App Store`}
							width="150"
							height="50"
						/>
					</a>
				) : (
					<a class="btn btn-primary" href={study.primaryCta.href} target="_blank" rel="noopener noreferrer">
						{study.primaryCta.label}
					</a>
				)
			}
			<a class="btn btn-secondary" href={study.secondaryCta.href} target="_blank" rel="noopener noreferrer">
				{study.secondaryCta.label}
			</a>
		</div>
	</div>

	<figure
		class="col-media"
		transition:name={iconName}
		transition:animate="initial"
		style="view-transition-class: app-icon"
	>
		<Image
			src={study.hero}
			alt={study.heroAlt}
			widths={[440, 680, 880]}
			sizes="(max-width: 900px) 340px, 440px"
			loading="eager"
			fetchpriority="high"
		/>
	</figure>
</header>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
		align-items: center;
		gap: 56px;
		padding-block: 44px 8px;
	}

	.col-type {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 12px 18px;
	}

	.status {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--accent);
		background: color-mix(in oklab, var(--accent) 10%, transparent);
		border-radius: 999px;
		padding: 4px 12px;
	}

	h1 {
		font-size: clamp(38px, 5vw, 66px);
	}

	.lead {
		max-width: 46ch;
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--fg-2);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 6px;
	}

	/* Official App Store badge: fixed art, so only the hit area is styled. */
	.badge-link {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-md);
	}

	.badge-link img {
		height: 50px;
		width: auto;
	}

	/* Square frame sized for app icon artwork. */
	.col-media {
		margin: 0;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		border: 1px solid var(--hairline);
		border-radius: 22.5%;
		background: var(--surface-2);
		box-shadow: var(--shadow);
	}

	.col-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
			padding-block: 36px 0;
		}

		.col-media {
			max-width: 340px;
		}
	}

	@media (max-width: 700px) {
		.cta-row .btn {
			flex: 1 1 auto;
		}
	}
</style>

<style is:global>
	/* Shared app-icon morph. View-transition pseudo-elements hang off the
	   document root, so this cannot be scoped. It is repeated verbatim in
	   ProjectCard.astro because the rules that time a transition come from the
	   incoming page: this copy drives the trip out to the hero, that one the
	   trip back to a card. Only the travelling group is retimed; the rest of
	   the page keeps Astro's default fade.

	   Both ends are rounded squares clipped at 22.5%, so the snapshots already
	   carry their corners and scale them in proportion, and the icon never
	   passes through a square frame on the way.

	   view-transition-class is Chrome 125+ and Safari 18.2+. Where it is
	   missing this selector is dropped and the icon still morphs, on the
	   browser's default 0.25s ease. Under reduced motion Astro switches every
	   view-transition animation off, so the icon is simply in its new place;
	   the guard here keeps this rule from ever reintroducing travel. */
	@media (prefers-reduced-motion: no-preference) {
		::view-transition-group(*.app-icon) {
			animation-duration: 0.48s;
			animation-timing-function: var(--ease-out-soft, cubic-bezier(0.32, 0.72, 0, 1));
		}
	}
</style>
