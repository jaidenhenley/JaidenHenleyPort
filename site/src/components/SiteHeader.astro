---
import { projects } from '../data/projects';

const links = [
	{ label: 'Case Studies', href: '/case-studies' },
	{ label: 'About', href: '/#about' },
	{ label: 'Resume', href: '/resume' },
	{ label: 'Contact', href: '/contact' },
];

// Mirrors isCurrentNavLink() in the script below, evaluated once at render
// time so the first paint (and any page that never runs client JS) still
// gets the right link marked. The script re-runs this on every
// astro:page-load since the header persists across client-side navigations.
function isCurrentNavLink(href: string, pathname: string): boolean {
	if (href === '/#about') return false;

	let normalized = pathname.replace(/\.html$/, '');
	if (normalized.length > 1) normalized = normalized.replace(/\/$/, '');
	if (normalized === '') normalized = '/';

	if (href === '/case-studies') {
		return normalized === '/case-studies' || caseStudyPaths.includes(normalized);
	}

	return href === normalized;
}

// The real list of case study pages, rather than "anything unrecognised",
// so a 404 (which keeps the missing URL) or a privacy page highlights nothing.
const caseStudyPaths = projects.map((project) => `/${project.slug}`);
const currentPath = Astro.url.pathname;
---

<header class="site-header" transition:persist="site-header" data-case-studies={caseStudyPaths.join(' ')}>
	<div class="container inner">
		<a class="wordmark" href="/">Jaiden Henley</a>

		<nav class="nav" aria-label="Main">
			{links.map((link) => (
				<a href={link.href} aria-current={isCurrentNavLink(link.href, currentPath) ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>

		<div class="actions">
			<button class="theme-toggle" type="button" aria-label="Switch color theme">
				<svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
					<circle cx="10" cy="10" r="3.6"></circle>
					<path d="M10 1.6v2M10 16.4v2M18.4 10h-2M3.6 10h-2M15.94 4.06l-1.42 1.42M5.48 14.52l-1.42 1.42M15.94 15.94l-1.42-1.42M5.48 5.48L4.06 4.06"></path>
				</svg>
				<svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M17 12.2A7.4 7.4 0 0 1 7.8 3a7.4 7.4 0 1 0 9.2 9.2z"></path>
				</svg>
			</button>

			<button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav">
				<span></span><span></span>
			</button>
		</div>
	</div>

	<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" inert hidden>
		<div class="container">
			{links.map((link) => (
				<a href={link.href} aria-current={isCurrentNavLink(link.href, currentPath) ? 'page' : undefined}>{link.label}</a>
			))}
		</div>
	</nav>
</header>

<script>
	// This <script> is bundled as a single module and evaluated once, even
	// though the header persists across view transitions (transition:persist),
	// so these listeners are only ever bound a single time.
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
	const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function effectiveTheme(): 'light' | 'dark' {
		if (root.dataset.theme === 'light' || root.dataset.theme === 'dark') {
			return root.dataset.theme;
		}
		return prefersDark.matches ? 'dark' : 'light';
	}

	toggle?.addEventListener('click', () => {
		const next = effectiveTheme() === 'dark' ? 'light' : 'dark';

		if (!prefersReducedMotion.matches) {
			root.classList.add('theme-transition');
			window.setTimeout(() => root.classList.remove('theme-transition'), 350);
		}

		// If the chosen theme matches the OS preference, drop the stored
		// override entirely so the site keeps following the OS from then on,
		// instead of pinning to that theme forever.
		if (next === (prefersDark.matches ? 'dark' : 'light')) {
			delete root.dataset.theme;
			try {
				localStorage.removeItem('theme');
			} catch {}
		} else {
			root.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {}
		}
	});

	let navOpenTimeout: ReturnType<typeof setTimeout> | undefined;

	function closeMobileNav(returnFocus = false) {
		if (!mobileNav || !navToggle) return;
		if (navToggle.getAttribute('aria-expanded') !== 'true') return;

		navToggle.setAttribute('aria-expanded', 'false');
		mobileNav.dataset.state = 'closed';
		mobileNav.inert = true;

		clearTimeout(navOpenTimeout);
		const delay = prefersReducedMotion.matches ? 0 : 220;
		navOpenTimeout = setTimeout(() => {
			mobileNav.hidden = true;
		}, delay);

		if (returnFocus) navToggle.focus();
	}

	function openMobileNav() {
		if (!mobileNav || !navToggle) return;
		clearTimeout(navOpenTimeout);
		mobileNav.hidden = false;
		mobileNav.inert = false;
		// Force layout so the browser picks up `hidden` being removed before
		// flipping the data-state, which is what actually animates.
		void mobileNav.offsetHeight;
		mobileNav.dataset.state = 'open';
		navToggle.setAttribute('aria-expanded', 'true');
	}

	navToggle?.addEventListener('click', () => {
		const open = navToggle.getAttribute('aria-expanded') === 'true';
		if (open) {
			closeMobileNav();
		} else {
			openMobileNav();
		}
	});

	mobileNav?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).tagName !== 'A') return;
		closeMobileNav();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (navToggle?.getAttribute('aria-expanded') !== 'true') return;
		closeMobileNav(true);
	});

	document.addEventListener('astro:before-swap', () => closeMobileNav());

	// The header only renders once (transition:persist), so the aria-current
	// set at build/render time is only ever correct for the first page of a
	// visit. Every subsequent client-side navigation has to re-derive it here,
	// mirroring isCurrentNavLink() in the frontmatter above.
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav a, .mobile-nav a');
	const caseStudyPaths = (document.querySelector<HTMLElement>('.site-header')?.dataset.caseStudies ?? '').split(' ');

	function isCurrentNavLink(href: string, pathname: string): boolean {
		if (href === '/#about') return false;

		let normalized = pathname.replace(/\.html$/, '');
		if (normalized.length > 1) normalized = normalized.replace(/\/$/, '');
		if (normalized === '') normalized = '/';

		if (href === '/case-studies') {
			return normalized === '/case-studies' || caseStudyPaths.includes(normalized);
		}

		return href === normalized;
	}

	function updateActiveNavLinks() {
		const pathname = location.pathname;
		navLinks.forEach((link) => {
			const href = link.getAttribute('href') ?? '';
			if (isCurrentNavLink(href, pathname)) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}
		});
	}

	document.addEventListener('astro:page-load', updateActiveNavLinks);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--nav-bg);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		backdrop-filter: saturate(180%) blur(20px);
		border-bottom: 1px solid var(--hairline-2);
	}

	/* Soft scroll edge: replaces the hard hairline/shadow combo in motion.css
	   with a faint gradient that fades in under the header once scrolled,
	   read by motion.css's .is-scrolled state (toggled by ScrollMotion.astro). */
	.site-header::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 14px;
		pointer-events: none;
		opacity: 0;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.06), transparent);
		transition: opacity 0.3s var(--ease-in-out-soft, ease);
	}

	:global(:root[data-theme='dark']) .site-header::after {
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), transparent);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .site-header::after {
			background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), transparent);
		}
	}

	.site-header.is-scrolled::after {
		opacity: 1;
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header {
			background: var(--bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	@media (prefers-contrast: more) {
		.site-header {
			background: var(--bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			border-bottom: 1px solid var(--fg-3);
		}
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-height: 60px;
	}

	.wordmark {
		font-size: var(--step-0);
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 30px;
		margin-inline-start: auto;
	}

	.nav a {
		font-size: 0.875rem;
		font-weight: 450;
		color: var(--fg-2);
	}

	.nav a:hover {
		color: var(--fg);
	}

	/* Colour only: a weight change would widen the link and nudge its
	   neighbours every time the persisted header updates. */
	.nav a[aria-current='page'] {
		color: var(--fg);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.theme-toggle,
	.nav-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: none;
		border-radius: 10px;
		background: transparent;
		color: var(--fg-2);
		cursor: pointer;
		transition: background 0.18s ease, color 0.18s ease;
	}

	.theme-toggle:hover,
	.nav-toggle:hover {
		background: var(--surface-2);
		color: var(--fg);
	}

	.icon-moon {
		display: none;
	}

	:global(:root[data-theme='dark']) .icon-sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .icon-moon {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: none;
		}

		:global(:root:not([data-theme='light'])) .icon-moon {
			display: block;
		}
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
	}

	.nav-toggle span {
		display: block;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-toggle[aria-expanded='true'] span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	.mobile-nav {
		border-top: 1px solid var(--hairline-2);
		padding-block: 8px 16px;
		transform-origin: top;
		opacity: 0;
		transform: translateY(-8px);
		transition: opacity 0.22s ease-out, transform 0.22s ease-out;
	}

	.mobile-nav[data-state='open'] {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav {
			transform: none;
			transition: opacity 0.12s linear;
		}
	}

	.mobile-nav :global(.container) {
		display: flex;
		flex-direction: column;
	}

	.mobile-nav a {
		display: flex;
		align-items: center;
		min-height: 48px;
		font-size: var(--step-1);
		font-weight: 450;
		color: var(--fg-2);
	}

	.mobile-nav a[aria-current='page'] {
		color: var(--fg);
	}

	@media (max-width: 720px) {
		.nav {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}
</style>
