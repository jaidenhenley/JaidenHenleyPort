---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/motion.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CaseStudyFooter from '../components/CaseStudyFooter.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
import portrait from '../assets/images/pic08.jpeg';

interface Props {
	title: string;
	description: string;
	footerVariant?: 'default' | 'cta';
	ogImage?: ImageMetadata;
}

const { title, description, footerVariant = 'default', ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Shared-link preview: a square app icon crops cleanly as a "summary" card,
// otherwise fall back to the portrait cropped to the wide "summary_large_image"
// aspect Twitter/OG expect.
const socialImage = ogImage
	? await getImage({ src: ogImage, width: 1200, height: 1200, format: 'png' })
	: await getImage({ src: portrait, width: 1200, height: 630, format: 'jpg', fit: 'cover', position: 'attention' });
const twitterCard = ogImage ? 'summary' : 'summary_large_image';
const socialImageUrl = new URL(socialImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#08080a" media="(prefers-color-scheme: dark)" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jaiden Henley" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content={String(socialImage.attributes.width)} />
		<meta property="og:image:height" content={String(socialImage.attributes.height)} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:image" content={socialImageUrl} />

		<ClientRouter />

		<Analytics />

		<script is:inline>
			// Applied before first paint so the page never flashes the wrong theme.
			(() => {
				const applyRootState = (doc) => {
					try {
						const stored = localStorage.getItem('theme');
						if (stored === 'light' || stored === 'dark') {
							doc.documentElement.dataset.theme = stored;
						}
					} catch {}
					// Gates every reveal style, so content stays visible if JS never runs.
					doc.documentElement.classList.add('js');
				};
				applyRootState(document);
				// ClientRouter replaces <html> attributes with the incoming page's on
				// every navigation, so re-apply the saved theme before the swap.
				document.addEventListener('astro:before-swap', (event) => {
					applyRootState(event.newDocument);
					// The router restores scroll with a plain scrollTo() right after
					// the swap, which the global smooth scroll-behavior would animate,
					// so Back would visibly glide down from the top. Page changes jump
					// instantly; in-page anchors keep their smooth scroll once the new
					// page has loaded. Set on the incoming <html> because the router
					// copies its attributes over the current one.
					event.newDocument.documentElement.style.scrollBehavior = 'auto';
				});
				document.addEventListener('astro:page-load', () => {
					requestAnimationFrame(() => {
						document.documentElement.style.removeProperty('scroll-behavior');
					});
				});
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main">
			<slot />
		</main>
		{footerVariant === 'cta' ? <CaseStudyFooter /> : <SiteFooter />}

		<ScrollMotion />

		<style>
			.skip-link {
				position: absolute;
				left: 50%;
				translate: -50% -120%;
				z-index: 100;
				padding: 10px 18px;
				border-radius: 0 0 var(--radius-md) var(--radius-md);
				background: var(--accent);
				color: var(--accent-fg);
				font-size: var(--step--1);
				font-weight: 550;
				transition: translate 0.18s ease;
			}

			.skip-link:focus-visible {
				translate: -50% 0;
				color: var(--accent-fg);
			}
		</style>
	</body>
</html>
