---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
	title="Contact | Jaiden Henley"
	description="Get in touch with Jaiden Henley about iOS roles, contract work, or collaboration."
>
	<PageHeader
		eyebrow="Send a message"
		title="Contact"
		intro="If you want to collaborate, discuss an iOS role, or review my case studies, send me a message and I will respond as soon as I can."
	/>

	<section class="section contact-section">
		<div class="container grid">
			<form class="card form" action="https://formsubmit.co/jaidenhenleydev@gmail.com" method="POST">
				<input type="hidden" name="_subject" value="New Portfolio Contact Form Message" />
				<input type="hidden" name="_captcha" value="false" />
				<input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" />

				<div class="row">
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" autocomplete="name" required />
					</label>
					<label class="field">
						<span>Email</span>
						<input type="email" name="email" autocomplete="email" required />
					</label>
				</div>

				<label class="field">
					<span>Subject</span>
					<input type="text" name="subject" required />
				</label>

				<label class="field">
					<span>Message</span>
					<textarea name="message" rows="7" required></textarea>
				</label>

				<button class="btn btn-primary submit" type="submit">Send message</button>
			</form>
		</div>
	</section>
</Base>

<style>
	.contact-section {
		padding-block: 0 var(--section-y);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(32px, 5vw, 64px);
		align-items: start;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: clamp(24px, 3vw, 34px);
		max-width: 720px;
	}

	.row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field span {
		font-size: var(--step--1);
		font-weight: 550;
		color: var(--fg-2);
	}

	.field input,
	.field textarea {
		width: 100%;
		min-height: 48px;
		padding: 12px 14px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		background: var(--bg);
		color: var(--fg);
		font-family: inherit;
		font-size: var(--step-0);
		line-height: 1.5;
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.field textarea {
		resize: vertical;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 18%, transparent);
	}

	.submit {
		align-self: flex-start;
	}

	@media (max-width: 600px) {
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
