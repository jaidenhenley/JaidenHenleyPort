---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const successRedirectUrl = new URL('/contact?sent=1', Astro.site ?? Astro.url).href;
---

<Base
	title="Contact | Jaiden Henley"
	description="Get in touch with Jaiden Henley about iOS roles, contract work, or collaboration."
>
	<PageHeader
		eyebrow="Send a message"
		title="Contact"
		intro="If you want to collaborate, discuss an iOS role, or review my case studies, send me a message and I will respond as soon as I can."
	/>

	<section class="section contact-section">
		<div class="container grid">
			<form class="card form" action="https://formsubmit.co/jaidenhenleydev@gmail.com" method="POST">
				<input type="hidden" name="_subject" value="New Portfolio Contact Form Message" />
				<input type="hidden" name="_captcha" value="false" />
				<input type="hidden" name="_next" value={successRedirectUrl} />
				<input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" />

				<div class="row">
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" autocomplete="name" required />
					</label>
					<label class="field">
						<span>Email</span>
						<input type="email" name="email" autocomplete="email" required />
					</label>
				</div>

				<label class="field">
					<span>Subject</span>
					<input type="text" name="subject" required />
				</label>

				<label class="field">
					<span>Message</span>
					<textarea name="message" rows="7" required></textarea>
				</label>

				<p class="status error" role="alert" hidden>
					Something went wrong. Please try again, or email
					<a href="mailto:jaidenhenleydev@gmail.com">jaidenhenleydev@gmail.com</a>.
				</p>

				<button class="btn btn-primary submit" type="submit">Send message</button>
			</form>

			<p class="card status success" role="status" tabindex="-1" hidden>
				Thanks, your message is on its way. I'll reply within a couple of days.
			</p>
		</div>
	</section>
</Base>

<style>
	.contact-section {
		padding-block: 0 var(--section-y);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(32px, 5vw, 64px);
		align-items: start;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: clamp(24px, 3vw, 34px);
		max-width: 720px;
	}

	.row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field span {
		font-size: var(--step--1);
		font-weight: 550;
		color: var(--fg-2);
	}

	.field input,
	.field textarea {
		width: 100%;
		min-height: 48px;
		padding: 12px 14px;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-md);
		background: var(--bg);
		color: var(--fg);
		font-family: inherit;
		font-size: var(--step-0);
		line-height: 1.5;
		transition: border-color 0.18s ease, box-shadow 0.18s ease;
	}

	.field textarea {
		resize: vertical;
	}

	.field input:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 18%, transparent);
	}

	/* The flex display above would otherwise beat the hidden attribute. */
	.form[hidden] {
		display: none;
	}

	.submit {
		align-self: flex-start;
	}

	.field input[aria-invalid="true"],
	.field textarea[aria-invalid="true"] {
		border-color: #d70015;
	}

	:root[data-theme="dark"] .field input[aria-invalid="true"],
	:root[data-theme="dark"] .field textarea[aria-invalid="true"] {
		border-color: #ff6961;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme="light"]) .field input[aria-invalid="true"],
		:root:not([data-theme="light"]) .field textarea[aria-invalid="true"] {
			border-color: #ff6961;
		}
	}

	.status {
		margin: 0;
		font-size: var(--step--1);
		padding: 12px 14px;
		border-radius: var(--radius-md);
		--status-color: #d70015;
	}

	.status.success {
		--status-color: #1a9d3a;
		max-width: 720px;
		padding: 20px 22px;
		font-size: var(--step-0);
		color: var(--fg);
		background: color-mix(in oklab, var(--status-color) 15%, var(--bg));
		border-left: 3px solid var(--status-color);
	}

	.status.error {
		color: var(--fg);
		background: color-mix(in oklab, var(--status-color) 15%, var(--bg));
		border-left: 3px solid var(--status-color);
	}

	.status a {
		color: inherit;
		text-decoration: underline;
	}

	@media (max-width: 600px) {
		.row {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const form = document.querySelector<HTMLFormElement>('.contact-section form');
		const success = document.querySelector<HTMLElement>('.contact-section .status.success');
		const error = form?.querySelector<HTMLElement>('.status.error');
		const submit = form?.querySelector<HTMLButtonElement>('.submit');
		if (!form || !success || !error || !submit) return;

		const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
			'.field input, .field textarea'
		);

		const showSuccess = () => {
			form.hidden = true;
			success.hidden = false;
		};

		// The no-JS fallback posts to formsubmit and comes back here with ?sent=1.
		if (new URLSearchParams(location.search).has('sent')) showSuccess();

		if (form.dataset.bound === 'true') return;
		form.dataset.bound = 'true';

		// Errors only appear once a field has been left, never while it is still
		// empty and untouched, and clear the moment the value becomes valid.
		const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
			if (field.validity.valid) field.removeAttribute('aria-invalid');
			else field.setAttribute('aria-invalid', 'true');
		};
		fields.forEach((field) => {
			field.addEventListener('blur', () => {
				if (field.value) field.dataset.touched = 'true';
				if (field.dataset.touched) check(field);
			});
			field.addEventListener('input', () => {
				if (field.hasAttribute('aria-invalid')) check(field);
			});
		});

		const setBusy = (busy: boolean) => {
			submit.disabled = busy;
			submit.toggleAttribute('aria-busy', busy);
			submit.textContent = busy ? 'Sending…' : 'Send message';
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			error.hidden = true;

			if (!form.checkValidity()) {
				fields.forEach(check);
				form.reportValidity();
				return;
			}

			setBusy(true);
			try {
				const response = await fetch('https://formsubmit.co/ajax/jaidenhenleydev@gmail.com', {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				if (!response.ok) throw new Error(String(response.status));
				form.reset();
				showSuccess();
				success.focus();
			} catch {
				error.hidden = false;
			} finally {
				setBusy(false);
			}
		});
	});
</script>
